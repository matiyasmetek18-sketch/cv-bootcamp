{
  "input": "degraded.jpg",
  "output": "enhanced_degraded.jpg",
  "operations": [
    {
      "name": "to_grayscale"
    },
    {
      "name": "adjust_gamma",
      "gamma": 0.7
    },
    {
      "name": "normalize"
    },
    {
      "name": "contrast_stretch",
      "lower" : 50,
      "upper" : 200
    }
  ],
  "visualize": {
    "compute_histogram": false,
    "compute_color_histogram": false,
    "plot_before_after": true,
    "clahe_eqlz_before_after": true,
    "hist_before_after": true
  }
  
}